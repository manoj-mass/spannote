{
  "name": "@spannote/protocol",
  "version": "0.1.0",
  "description": "W3C Web Annotation Protocol client (HTTP, ETag concurrency) and storage adapter.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@spannote/model": "0.1.0"
  },
  "keywords": [
    "w3c",
    "annotation-protocol",
    "linked-data-platform",
    "annotation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manoj-mass/spannote.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  }
}

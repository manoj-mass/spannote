{
  "name": "@spannote/anchor",
  "version": "0.1.0",
  "description": "Describe and re-find text ranges in the DOM with W3C text selectors. Framework-agnostic.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@spannote/model": "0.1.0"
  },
  "keywords": [
    "annotation",
    "text-quote",
    "text-position",
    "anchoring",
    "dom"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manoj-mass/spannote.git",
    "directory": "packages/anchor"
  },
  "homepage": "https://github.com/manoj-mass/spannote/tree/main/packages/anchor#readme",
  "bugs": {
    "url": "https://github.com/manoj-mass/spannote/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  }
}

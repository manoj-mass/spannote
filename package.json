{
  "name": "spannote-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "SpanNote: W3C-conformant annotations for the web. Monorepo root.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @spannote/model && npm run build -w @spannote/anchor && npm run build -w @spannote/render && npm run build -w @spannote/protocol && npm run build -w @spannote/core && npm run build -w @spannote/react && npm run build -w @spannote/vue && npm run build -w @spannote/angular",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run demo:build",
    "changeset": "changeset",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "npm run build && changeset publish",
    "demo": "npm run dev -w @spannote/demo-react",
    "demo:vue": "npm run dev -w @spannote/demo-vue",
    "demo:server": "npm run server -w @spannote/demo-react",
    "demo:angular": "npm run start -w @spannote/demo-angular",
    "demo:build": "npm run build -w @spannote/demo-react && npm run build -w @spannote/demo-vue && npm run build -w @spannote/demo-angular",
    "demo:smoke": "npm run smoke -w @spannote/demo-react"
  },
  "devDependencies": {
    "@angular/common": "~21.2.26",
    "@angular/compiler": "~21.2.26",
    "@angular/compiler-cli": "~21.2.26",
    "@angular/core": "~21.2.26",
    "@angular/platform-browser": "~21.2.26",
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "ng-packagr": "~21.2.7",
    "prettier": "^3.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.45"
  }
}
